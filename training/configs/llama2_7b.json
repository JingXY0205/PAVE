{
  "model_id": "meta-llama/Llama-2-7b-hf",
  "transformers_version": "4.37.2",
  "bos_token_id": 1,
  "eos_token_id": 2,
  "separate_tokenizer": false,
  "backbone": {
    "model_type": "llama",
    "hidden_size": 4096,
    "num_hidden_layers": 32,
    "num_attention_heads": 32,
    "num_key_value_heads": 32,
    "max_position_embeddings": 4096,
    "rope_theta": 10000.0,
    "rope_scaling": null,
    "vocab_size": 32000
  },
  "dca": {"pretraining_length": 4096, "local_window_size": 512},
  "pave": {
    "routing_interval": 512,
    "query_observation_tokens": 128,
    "initial_remote_keep_ratio": 0.5,
    "min_remote_keep_ratio": 0.05,
    "sparsity_decay_strength": 3.0,
    "concentration_gamma": 1.0,
    "salience_temperature": 0.5,
    "boundary_temperature": 0.1,
    "reuse_representatives": true,
    "reuse_packed_kv": false
  },
  "data": {
    "length_buckets": [8192, 16384, 24576, 32768],
    "min_tokens": 6144,
    "max_answer_tokens": 1024,
    "prompt_tail_max_tokens": 4096,
    "validation_examples": 32
  },
  "training": {
    "steps": 90,
    "warmup_steps": 5,
    "seed": 42,
    "router_lr": 0.0002,
    "representative_lr": 0.0001,
    "weight_decay": 0.0,
    "lambda_kl": 0.1,
    "router_st_gradient_scale": 5.0,
    "grad_clip": 5.0,
    "logit_chunk": 16,
    "eval_every": 90,
    "save_every": 10,
    "cpu_activation_offload": true
  }
}
